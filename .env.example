# ── AI Contract Risk Analyser ──
# Copy this file to .env and fill in real values.

# Hugging Face access token (optional – only needed for gated models)
HF_TOKEN=

# Classifier backend engine: auto | tfidf | legalbert | zeroshot | keyword
CLASSIFIER_BACKEND=tfidf

# Pretrained Hugging Face LegalBERT model fine-tuned for contract clause classification
LEGALBERT_MODEL_NAME=AmirLGass/clauseguard-legalbert

# Zero-shot classification model (fallback / alternative)
CLASSIFIER_MODEL_NAME=facebook/bart-large-mnli

# Minimum confidence threshold (0.0 to 1.0) before flagging as low_confidence
CONFIDENCE_THRESHOLD=0.35

# Maximum sequence length for transformer tokenization
CLASSIFIER_MAX_SEQ_LENGTH=512

# ── Phase 5 Generative AI Explanation Engine ────────────────────────
# Provider options: template | mock | hf_inference | openai_compatible | local_pipeline
LLM_PROVIDER=template

# Instruction-following LLM identifier (Hugging Face model ID or local identifier)
LLM_MODEL_NAME=Qwen/Qwen2.5-Coder-1.5B-Instruct

# Dedicated endpoint URL (required for openai_compatible or dedicated HF endpoints)
# Example for Ollama: http://localhost:11434/v1
# Example for vLLM:   http://localhost:8000/v1
LLM_ENDPOINT_URL=

# API key for the LLM provider (if not set, falls back to HF_TOKEN)
LLM_API_KEY=

# Request timeout in seconds
LLM_TIMEOUT_SECONDS=15.0

# Maximum retries on network/rate-limit errors
LLM_MAX_RETRIES=2

# Generation temperature (low for factual/grounded outputs)
LLM_TEMPERATURE=0.1

# Explicit opt-in for external cloud inference (privacy safeguard)
ENABLE_EXTERNAL_LLM=false

# Legacy explanation / summarisation model
EXPLAINER_MODEL_NAME=google/flan-t5-base

# Application settings
APP_TITLE=AI Contract Risk Analyser
MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=INFO

